# Calibre Git ignore rules
#
# Principle: commit source code, configuration, documentation, tests, and
# reproducibility manifests. Keep large research data and generated outputs
# outside the GitHub repository.


# -----------------------------------------------------------------------------
# Large research data
# -----------------------------------------------------------------------------

# The data/ tree contains local inputs, preprocessing scripts, and generated
# intermediates. Keep it outside the Calibre repository entirely.
/data/

# Local-only workflow code and auxiliary materials. These remain available in
# the workspace but are not part of the Calibre repository release.
/scripts/
/tools/
/tests/
/reference/

# Historical snapshots and downloaded inputs.
/incoming/

# Local caches and temporary working directories.
/cache/
/.cache/
/tmp/
/.tmp/
/scratch/


# -----------------------------------------------------------------------------
# Generated analysis outputs
# -----------------------------------------------------------------------------

/results/
/logs/
/figure/*
!/figure/fig1.png
/figures/
/QualityControl/
/ArchRLogs/
/.Rcheck/
*.arrow
*.bgz.tbi

# Common generated output formats. Final, selected figures should be copied to
# a separately reviewed release/ directory if they need to be saved.
*.log
*.out
*.err
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz


# -----------------------------------------------------------------------------
# R / RStudio / package artifacts
# -----------------------------------------------------------------------------

.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rcheck/
*.tar.gz
*.Rout


# Keep renv.lock if it is created; ignore only the installed package library.
/.Rlib/
renv/library/
renv/staging/
packrat/lib/
packrat/src/

# Keep only the Calibre package implementation in the GitHub repository.
/config/*
/docs/*
/R/*
!/R/Calibre.R
!/R/helper.R

# Keep only help files generated from the two package source files.
/man/*
!/man/Calibre.Rd
!/man/CalibreDiff.Rd
!/man/CalibreDynamic.Rd
!/man/CalibreDynamicPredict.Rd
!/man/CalibreFilter.Rd
!/man/Calibre_single.Rd
!/man/CanonicalPeakNames.Rd
!/man/CollapseToLongestTranscript.Rd
!/man/FilterGenePeakPairs.Rd
!/man/GetGenePeakPairs.Rd
!/man/InferPeakSeparator.Rd
!/man/binary_search.Rd
!/man/calibre_pair_seeds.Rd
!/man/validate_with_assay.Rd
!/man/validate_with_assay1.Rd


# -----------------------------------------------------------------------------
# Python and other local environments
# -----------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/


# -----------------------------------------------------------------------------
# Secrets and machine-specific configuration
# -----------------------------------------------------------------------------

.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*

# Local scheduler/job files and machine-specific settings.
slurm-*.out
*.job
*.pbs
*.qsub


# -----------------------------------------------------------------------------
# Editors and operating systems
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
