# EpiLink Git ignore rules
#
# Principle: commit source code, configuration, documentation, tests, and
# reproducibility manifests. Keep large research data and generated outputs
# outside the GitHub repository.


# -----------------------------------------------------------------------------
# Large research data
# -----------------------------------------------------------------------------

# The data/ and reference/ trees contain FASTQ, SRA, H5AD, RDS, genome/index
# files, and other large inputs. Their README files and processing scripts are
# explicitly unignored below.
/data/**
/reference/**

# Historical snapshots and downloaded inputs.
/incoming/

# Local caches and temporary working directories.
/cache/
/.cache/
/tmp/
/.tmp/
/scratch/


# -----------------------------------------------------------------------------
# Generated analysis outputs
# -----------------------------------------------------------------------------

/results/
/logs/

# Common generated output formats. Final, selected figures should be copied to
# a separately reviewed release/ directory if they need to be saved.
*.log
*.out
*.err
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz


# -----------------------------------------------------------------------------
# Keep documentation and reproducibility code inside data/reference trees
# -----------------------------------------------------------------------------

# Unignore directories so the files below can be tracked.
!/data/**/
!/reference/**/

# Dataset documentation and small reproducibility instructions.
!/data/**/*.md
!/data/**/README.txt
!/reference/**/*.md
!/reference/**/README.txt

# Download, import, preprocessing, and validation scripts.
!/data/**/*.R
!/data/**/*.Rmd
!/data/**/*.sh
!/data/**/*.py
!/reference/**/*.R
!/reference/**/*.Rmd
!/reference/**/*.sh
!/reference/**/*.py

# Checksum/provenance manifests may be committed when they contain metadata
# only. Large raw tables should remain ignored and be added deliberately with
# `git add -f` only after review.
!/data/**/*manifest*.tsv
!/reference/**/*manifest*.tsv
!/data/**/*checksums*.txt
!/reference/**/*checksums*.txt


# -----------------------------------------------------------------------------
# R / RStudio / package artifacts
# -----------------------------------------------------------------------------

.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rcheck/
*.tar.gz
*.Rout

# Keep renv.lock if it is created; ignore only the installed package library.
renv/library/
renv/staging/
packrat/lib/
packrat/src/


# -----------------------------------------------------------------------------
# Python and other local environments
# -----------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/


# -----------------------------------------------------------------------------
# Secrets and machine-specific configuration
# -----------------------------------------------------------------------------

.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*

# Local scheduler/job files and machine-specific settings.
slurm-*.out
*.job
*.pbs
*.qsub


# -----------------------------------------------------------------------------
# Editors and operating systems
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
